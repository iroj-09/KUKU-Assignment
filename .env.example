# --- Connect a model: a model name + an API key is enough ---------------------------
# The vendor is detected from the key prefix / model name (see src/llm.py).
# Or run:  python scripts/setup_model.py   (asks for both, tests them, saves them here)

LLM_MODEL=gemini-3.5-flash-lite
LLM_API_KEY=your_api_key_here

# Examples (use ONE pair):
#   LLM_MODEL=gpt-4o-mini                           LLM_API_KEY=sk-...
#   LLM_MODEL=claude-haiku-4-5                      LLM_API_KEY=sk-ant-...
#   LLM_MODEL=meta-llama/Llama-3.1-8B-Instruct      LLM_API_KEY=hf_...        (Hugging Face)
#   LLM_MODEL=llama3.1  LLM_PROVIDER=ollama                                    (local, no key)
#   LLM_MODEL=my-model  LLM_BASE_URL=https://my-server/v1  LLM_API_KEY=...     (any OpenAI-compatible API)
#
# Only if auto-detection guesses wrong: LLM_PROVIDER=gemini|anthropic|openai|huggingface|openrouter|groq|together|ollama
#
# The older GEMINI_API_KEY + GEMINI_MODEL pair still works if you prefer it.

# --- Optional tuning (defaults shown) ----------------------------------------------
# MIN_PROMO_SECONDS=20
# MAX_PROMO_SECONDS=60
# HOOK_WINDOW_SECONDS=3
# CLIFFHANGER_WINDOW_SECONDS=5
# LOCAL_WEIGHT=0.30
